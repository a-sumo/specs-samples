  InputLines:
    - '// @input SceneObject interactionObject {"hint":"Optional draggable handle. Its local X/Z position creates a moving gust in the field."}'
    - '// @input SceneObject metricCursorObject {"hint":"Optional draggable metric cursor. Its local X/Z position samples divergence and curl."}'
    - '// @input SceneObject planeGrabObject {"hint":"Optional planar grab handle. Its manipulation target is rebound to this field root at runtime."}'
    - '// @input float initialPreset = 3 {"hint":"Initial planar field preset.", "widget":"combobox", "values":[{"label":"Expansion", "value":0}, {"label":"Contraction", "value":1}, {"label":"Curl", "value":2}, {"label":"Motion", "value":3}]}'
    - '// @input float planeWidth = 48 {"widget":"slider", "min":8, "max":64, "step":0.5}'
    - '// @input float planeDepth = 28 {"widget":"slider", "min":5, "max":44, "step":0.5}'
    - '// @input float tracerCount = 264 {"widget":"slider", "min":30, "max":420, "step":5}'
    - '// @input float trailSamples = 10 {"widget":"slider", "min":4, "max":18, "step":1}'
    - '// @input float flowSpeed = 1.15 {"widget":"slider", "min":0.2, "max":4, "step":0.05}'
    - '// @input float gustStrength = 1.25 {"widget":"slider", "min":0, "max":3, "step":0.05}'
    - '// @input float gustRadius = 3.2 {"widget":"slider", "min":1, "max":8, "step":0.25}'
    - '// @input float curlStrength = 0.85 {"widget":"slider", "min":0, "max":3, "step":0.05}'
    - '// @input float arrowColumns = 15 {"widget":"slider", "min":5, "max":27, "step":1}'
    - '// @input float arrowRows = 9 {"widget":"slider", "min":3, "max":17, "step":1}'
    - '// @input float trailWidth = 0.075 {"widget":"slider", "min":0.02, "max":0.18, "step":0.005}'
    - '// @input float arrowLength = 0.42 {"widget":"slider", "min":0.15, "max":0.8, "step":0.025}'
    - '// @input float metricSampleStep = 0.55 {"widget":"slider", "min":0.18, "max":1.2, "step":0.02}'
    - '// @input bool enableHandInput {"hint":"Project tracked fingertips onto the plane and use their motion as field input. Disabled until SIK hand provider is initialized by the host experience."}'
    - '// @input float fingerInfluenceRadius = 2.6 {"hint":"How far each fingertip pushes the planar field, in centimeters.", "widget":"slider", "min":1, "max":8, "step":0.25}'
    - '// @input float fingerFieldStrength = 1 {"hint":"Multiplier for fingertip velocity injected into the field.", "widget":"slider", "min":0.1, "max":2.5, "step":0.05}'
    - '// @input float fingerProjectionDepthCm = 12 {"hint":"How far above/in front of the plane fingertips can be and still affect it.", "widget":"slider", "min":2, "max":24, "step":0.5}'
    - '// @input float maxFingerVelocityCmPerSec = 36 {"hint":"Clamp fingertip speed to reject tracking spikes.", "widget":"slider", "min":4, "max":80, "step":1}'
    - '// @input float flowMemorySeconds = 2 {"hint":"Field memory: seconds for stirred motion to ease back to rest after you stop. 0 = snap back instantly.", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - '// @input float flowAccumulation = 1 {"hint":"How strongly continued stirring builds up momentum in the field (cumulative energy).", "widget":"slider", "min":0, "max":3, "step":0.05}'
