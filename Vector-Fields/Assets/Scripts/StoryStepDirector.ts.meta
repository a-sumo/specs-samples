    - '// @input SceneObject windGlobeRoot {"hint":"Wind globe example rig."}'
    - '// @input SceneObject storyWidgetsRoot {"hint":"Older image widget group. Usually hidden while the new scaffold is active."}'
    - '// @input SceneObject legacyGuideRoot {"hint":"Older narration panel root to park while this director owns the story."}'
    - '// @input SceneObject legacySlideStageRoot {"hint":"Older slide stage root to park while this director owns the story."}'
