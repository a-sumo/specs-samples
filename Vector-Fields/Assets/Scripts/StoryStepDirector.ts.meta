    - '// @input vec3 analyticalFrontOffset = {0,8,-78} {"hint":"Camera-relative placement for analytical field-pattern examples."}'
    - '// @input vec3 gravityFrontOffset = {0,-6,-82} {"hint":"Camera-relative placement for gravity when reference calibration is disabled."}'
