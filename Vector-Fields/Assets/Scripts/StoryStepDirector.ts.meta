  InputLines:
    - '// @input SceneObject scaffoldRoot {"hint":"Storyboard scaffold root. Falls back to VF Story Scaffold by name."}'
    - '// @input SceneObject motionFieldRoot {"hint":"Planar motion field rig."}'
    - '// @input SceneObject analyticalPatternsRoot {"hint":"Analytical field-pattern library rig."}'
